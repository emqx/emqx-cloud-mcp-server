# Configure only this group for a Deployment connection.
EMQXCLOUD_DEPLOYMENT_ENDPOINT=https://your-deployment-host:8443/api/v5
EMQXCLOUD_DEPLOYMENT_API_KEY=
EMQXCLOUD_DEPLOYMENT_API_SECRET=

# Optional: used by authentication-user write tools; never passed as a tool argument.
# Nonempty MQTT password and integration secret values must have at least 8 characters.
EMQXCLOUD_MQTT_PASSWORD=

# Optional: secrets referenced from data-integration configs as {"$env": "EMQXCLOUD_SECRET_<NAME>"}.
# EMQXCLOUD_SECRET_WEBHOOK_TOKEN=
